@page
@model SendMeTheFuckingLog.Pages.IndexModel
@using System.Text.Json
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
    <title>发送诊断文件 · Mod Log Helper</title>
    <link rel="preconnect" href="@Model.ImageOrigin" />
    @foreach (var image in Model.PreloadedImages)
    {
        <link rel="preload" as="image" href="@image" referrerpolicy="no-referrer" />
    }
    <link rel="stylesheet" href="~/css/site.css" />
    <script id="page-configuration" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.PageConfiguration, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
    <script src="~/js/diagnostic-rules.js" defer></script>
    <script src="~/js/upload-page.js" defer></script>
</head>
<body>
    <header class="site-header">
        <a id="status-link" class="status-link" href="/status">status (debug)</a>
        <nav class="language-switch" aria-label="Language / 语言">
            <button type="button" data-language="zh" lang="zh-CN" aria-pressed="true">中文</button>
            <button type="button" data-language="en" lang="en" aria-pressed="false">English</button>
        </nav>
    </header>

    <main>
        <section class="intro" aria-labelledby="page-title">
            <h1 id="page-title"><span data-i18n="title">上传日志给</span> <strong id="author-name"></strong></h1>
            <aside class="supported-sidebar">
                <details id="supported-games-panel">
                    <summary data-i18n="supported">支持的游戏</summary>
                    <ul id="supported-games"></ul>
                </details>
            </aside>
        </section>

        <noscript><p class="notice">请启用 JavaScript 以使用文件选择和语言切换。Please enable JavaScript to use this page.</p></noscript>

        <section class="route-section" aria-labelledby="route-title">
            <h2 id="route-title" class="visually-hidden" data-i18n="chooseRoute">选择方式</h2>
            <div class="route-options" role="group" aria-labelledby="route-title">
                <button type="button" class="route-card selected" id="route-auto" aria-pressed="true" aria-controls="auto-panel">
                    <span class="route-symbol" aria-hidden="true">⌕</span>
                    <span class="route-text"><strong data-i18n="autoTitle">自动选择日志</strong></span>
                    <span class="choice-dot" aria-hidden="true"></span>
                </button>
                <button type="button" class="route-card" id="route-manual" aria-pressed="false" aria-controls="manual-panel">
                    <span class="route-symbol" aria-hidden="true">↥</span>
                    <span class="route-text"><strong data-i18n="manualTitle">手动选择日志</strong></span>
                    <span class="choice-dot" aria-hidden="true"></span>
                </button>
            </div>
        </section>

        <div class="workspace">
            <section id="auto-panel" aria-labelledby="auto-heading">
                <div id="automatic-source">
                    <div class="step-heading"><span class="step-number">1</span><div><h2 id="auto-heading" data-i18n="folderHeading">将整个游戏文件夹拖入</h2><p data-i18n="folderDescription">Steam 中右键游戏 → 管理 → 浏览本地文件。</p><p id="drag-instruction">全选文件，拖入右侧区域。</p></div></div>
                    <div class="guide-layout">
                        <div id="automatic-guide" class="guide-images" hidden></div>
                        <div class="guide-actions">
                            <div id="folder-drop" class="drop-zone">
                                <span class="folder-icon" aria-hidden="true"></span>
                                <h3 data-i18n="dropFolder">拖到这</h3>
                                <button type="button" class="primary-button" id="choose-folder" data-i18n="chooseFolder">浏览文件</button>
                                <input id="folder-input" type="file" webkitdirectory hidden />
                                <span class="drop-note" data-i18n="folderPrivacy">不会上传整个游戏，只会上传日志</span>
                            </div>
                            <p id="folder-status" class="status" role="status" aria-live="polite"></p>
                            <p id="auto-size-error" class="status error" role="status" aria-live="polite" hidden></p>
                            <div id="auto-selection-slot" class="selection-slot">
                                <section id="selection-section" class="selection-section" hidden aria-labelledby="selection-title">
                                    <div id="detected-game-info" class="detected-game-info" hidden></div>
                                    <div class="selection-heading"><h3 id="selection-title" class="visually-hidden" data-i18n="selectedFiles">已选择的文件</h3><span id="selection-summary"></span></div>
                                    <ul id="selected-files" class="file-list"></ul>
                                    <p id="missing-files" class="hint"></p>
                                </section>
                            </div>
                        </div>
                    </div>
                </div>
                <button type="button" id="cancel-scan" class="text-button" hidden data-i18n="cancelScan">取消查找</button>
                <div id="auto-help" class="notice" hidden><p data-i18n="autoHelp">请确认选择的是游戏安装文件夹。日志可能尚未生成，也可能位于所选目录之外。</p><button type="button" class="text-button" id="switch-manual" data-i18n="viewManual">查看手动查找指引 →</button></div>
            </section>

            <section id="manual-panel" aria-labelledby="manual-heading" hidden>
                <div class="step-heading"><span class="step-number">1</span><div><h2 id="manual-heading" data-i18n="gameHeading">选择游戏</h2></div></div>
                <fieldset id="manual-game-choice" class="game-picker" aria-labelledby="manual-heading">
                    <div id="game-cards" class="game-grid"></div>
                </fieldset>
                <div id="game-guide" class="guide-layout manual-guide-layout" hidden>
                    <div class="step-heading manual-upload-heading"><span class="step-number">2</span><div><h2 data-i18n="uploadHeading">上传日志</h2></div></div>
                    <div class="guide-box"><ol id="guide-steps"></ol></div>
                    <div class="guide-actions">
                        <div id="expected-files" class="expected-files"></div>
                        <details id="optional-files" class="optional-files" hidden>
                            <summary data-i18n="otherFiles">其他文件</summary>
                            <div id="optional-file-paths"></div>
                            <ol id="optional-guide-steps"></ol>
                        </details>
                        <div class="drop-zone compact" id="file-drop">
                            <h3 data-i18n="dropFiles">拖入日志文件</h3>
                            <button type="button" class="primary-button" id="choose-files" data-i18n="chooseFiles">选择文件</button>
                            <input id="file-input" type="file" multiple hidden />
                        </div>
                        <p id="manual-status" class="status" role="status" aria-live="polite"></p>
                        <p id="manual-size-error" class="status error" role="status" aria-live="polite" hidden></p>
                        <div id="manual-selection-slot" class="selection-slot"></div>
                    </div>
                </div>
            </section>

            <div id="upload-next-steps">
                <section class="identity-section" aria-labelledby="nickname-heading">
                    <div class="step-heading"><span class="step-number" id="nickname-step-number">2</span><h2 id="nickname-heading"><label for="nickname" data-i18n="nicknameHeading">输入昵称：</label></h2></div>
                    <div id="nickname-target" class="attention-target nickname-target">
                        <span class="attention-arrow" aria-hidden="true">⬇</span>
                        <input id="nickname" name="nickname" type="text" maxlength="60" autocomplete="off" spellcheck="false" required placeholder="例如N网Id" />
                    </div>
                </section>

                <div class="send-section"><div id="send-target" class="attention-target"><span class="attention-arrow" aria-hidden="true">⬇</span><button type="button" id="send-files" class="send-button" disabled>发送</button></div></div>
            </div>
            <progress id="upload-progress" max="100" value="0" hidden></progress>
            <p id="upload-status" class="status" role="status" aria-live="polite"></p>
            <div id="upload-receipt" class="notice" role="status" aria-live="polite" hidden><strong data-i18n="success">发送成功！</strong><p><span data-i18n="receiptHint">告诉作者，你填写的昵称是：</span> <strong id="receipt-nickname"></strong></p></div>
        </div>
    </main>
</body>
</html>
